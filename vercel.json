{
  "version": 2,
  "name": "ai-news-daily",
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/daily/(.*)",
      "dest": "/daily/$1"
    },
    {
      "src": "/weekly/(.*)",
      "dest": "/weekly/$1"
    }
  ]
}